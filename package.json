    "angular-ui-sortable": "^0.19.0",
    "es6-shim": "^0.35.3",
    "es7-shim": "^6.0.0",
    "sprintf-js": "^1.1.1"
  },
  "resolutions": {
    "angular": "npm:@brickhouse-tech/angular-lts@^1.10.4",
    "angular-animate": "npm:@brickhouse-tech/angular-lts@^1.10.4",
    "angular-sanitize": "npm:@brickhouse-tech/angular-lts@^1.10.4",
    "bootstrap-select": "~1.13.18",
    "bootstrap@~3.3.7": "patch:bootstrap@npm%3A3.4.1#~/.yarn/patches/bootstrap-3.4.1.patch",
    "bootstrap@npm:^3.3": "patch:bootstrap@npm%3A3.4.1#~/.yarn/patches/bootstrap-3.4.1.patch",
    "bootstrap@npm:^3.4.1": "patch:bootstrap@npm%3A3.4.1#~/.yarn/patches/bootstrap-3.4.1.patch",
