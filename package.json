    "jsdom": "^31.0.0",
    "json-loader": "^0.5.4",
    "karma": "6.4.4",
    "karma-coverage": "^1.1.1",
    "karma-jasmine": "1.1.2",
    "karma-jsdom-launcher": "^23.0.0",
    "karma-webpack": "~1.8.1",
    "lodash": "~4.18.0",
    "ng-annotate-webpack-plugin": "0.1.3",
    "numeral": "^2.0.6",
    "patternfly": "^3.15.0",
    "patternfly-bootstrap-treeview": "^2.1.5",
    "raw-loader": "0.5.1",
    "sass": "^1.69.0",
