    "lodash": "~4.18.0",
    "minimist@~0.0.1": "^0.2.4",
    "moment": "^2.31.0",
    "moment-timezone": "^0.5.35",
    "qs@~6.5.2": "^6.14.1",
    "shelljs": "^0.8.5"
  }
