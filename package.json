{
  "name": "@manageiq/ui-components",
  "version": "1.7.1",
  "description": "UI components for ManageIQ project",
  "main": "dist/js/ui-components.js",
  "scripts": {
    "start": "yarn run install-vendor && webpack serve",
    "test": "yarn run install-vendor && karma start",
    "prepack": "yarn run build",
    "build": "yarn run install-vendor && webpack --mode=production",
    "build-dev": "yarn run install-vendor && webpack --mode=development",
    "gettext:extract": "yarn run build && angular-gettext-cli --files './+(src|dist)/**/+(*.html|ui-components.js)' --dest './locale/ui-components.pot' --marker-names '__,N_' --no-line-numbers && yarn run gettext:validate",
    "gettext:validate": "node scripts/validate-gettext-catalog.js",
    "install-vendor": "webpack --config webpack.vendor.config.js --mode=development",
    "build-docs": "jsdoc -c jsdoc-conf.json",
    "test:security": "yarn npm audit --recursive --no-deprecations --environment production"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ManageIQ/ui-components.git"
  },
  "authors": [],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.0",
    "npm": "^10.8.2"
  },
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "@manageiq/font-fabulous": "^1.0.0",
    "@types/angular-mocks": "^1.7.0",
    "@types/angular-ui-router": "^1.1.35",
    "@types/jasmine": "^3.10.18",
    "@types/lodash": "4.14.182",
    "@types/node": "16.18.78",
    "@types/rx": "^4.0.0",
    "angular": "^1.8.3",
    "angular-animate": "^1.8.3",
    "angular-bootstrap": "^0.12.2",
    "angular-gettext-cli": "^1.2.0",
    "angular-mocks": "^1.8.3",
    "angular-patternfly": "^3.15.0",
    "angular-sanitize": "^1.8.3",
    "babel-eslint": "^10.0.0",
    "bootstrap-combobox": "^1.0.2",
    "bootstrap-datepicker": "^1.6.4",
    "bootstrap-select": "~1.12.1",
    "bootstrap-switch": "^3.3.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eonasdan-bootstrap-datetimepicker": "^4.17.43",
    "eslint": "~3.19.0",
    "expose-loader": "^5.0.1",
    "file-loader": "^0.11.0",
    "google-code-prettify": "^1.0.5",
    "html-webpack-plugin": "^5.6.8",
    "jasmine": "2.99.0",
    "jquery": "3.7.1",
    "jquery-match-height": "^0.7.0",
    "jquery-ui-bundle": "^1.12.1",
    "jsdoc": "^3.4.3",
    "jsdom": "~13.2.0",
    "karma": "6.4.4",
    "karma-coverage": "^1.1.1",
    "karma-jasmine": "1.1.2",
    "karma-jsdom-launcher": "~7.1.0",
    "karma-webpack": "^5.0.1",
    "lodash": "~4.18.0",
    "mini-css-extract-plugin": "^2.10.2",
    "numeral": "^2.0.6",
    "patternfly": "^3.15.0",
    "patternfly-bootstrap-treeview": "^2.1.5",
    "raw-loader": "0.5.1",
    "sass": "^1.69.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "tslint": "4.5.1",
    "tslint-loader": "3.5.4",
    "typescript": "~3.9.10",
    "ui-router": "^1.0.0-alpha0",
    "url-loader": "^4.1.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "angular-bootstrap-switch": "^0.5.1",
    "angular-dragdrop": "^1.0.13",
    "angular-ui-sortable": "^0.19.0",
    "es6-shim": "^0.35.3",
    "es7-shim": "^6.0.0",
    "sprintf-js": "^1.1.1"
  },
  "resolutions": {
    "angular": "1.8.3",
    "angular-animate": "1.8.3",
    "angular-sanitize": "1.8.3",
    "get-intrinsic": "1.3.0",
    "jquery": "3.7.1"
  }
}
